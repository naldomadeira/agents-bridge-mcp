{
  "name": "agentmate",
  "version": "0.6.0",
  "description": "AI agents work better together. AgentMate connects AI coding agents so they can collaborate, delegate, review, and help each other complete tasks.",
  "keywords": [
    "agents",
    "ai",
    "anthropic",
    "agentmate",
    "teammate",
    "claude",
    "claude-code",
    "codex",
    "codex-cli",
    "delegation",
    "mcp",
    "multi-agent",
    "openai",
    "plugin"
  ],
  "homepage": "https://github.com/naldomadeira/agentmate#readme",
  "bugs": {
    "url": "https://github.com/naldomadeira/agentmate/issues"
  },
  "license": "MIT",
  "author": "Naldo Madeira <naldomadeira@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naldomadeira/agentmate.git"
  },
  "bin": {
    "agentmate": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "assets",
    "templates",
    "hooks"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-check",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check src/ test/",
    "publint": "publint",
    "prepublishOnly": "pnpm build",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:cli": "node scripts/smoke-built-cli.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "release": "node scripts/bump-version.mjs",
    "release:prepare": "pnpm version:check && pnpm build && pnpm smoke:pack && pnpm smoke:cli",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "citty": "^0.2.0",
    "consola": "^3.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "bumpp": "^10.4.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "publint": "^0.3.17",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.29.2"
}
